# Dodo SANDBOX env template — copy to repo root as .env.sandbox and fill in.
# Sandbox credentials live in the Dodo dashboard when the top toggle is set to
# Sandbox / Test mode. NEVER put live keys here, and never commit .env.sandbox.

# Sandbox API key (pk_test_…)
DODO_PAYMENTS_API_KEY=

# Sandbox webhook signing key
DODO_PAYMENTS_WEBHOOK_KEY=

# test_mode = sandbox; live_mode = production (do NOT set live here)
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Product ids FROM THE SANDBOX CATALOG (create them if the sandbox is empty)
DODO_PRODUCT_BASIC=
DODO_PRODUCT_PRO=
DODO_PRODUCT_ADVANCED=

# Where the payer lands after checkout — your local server in this flow
DODO_PAYMENTS_RETURN_URL=http://127.0.0.1:3100/welcome

# Optional test-card overrides (defaults match Dodo's docs)
# DODO_TEST_CARD=4242 4242 4242 4242
# DODO_TEST_EXPIRY=06/32
# DODO_TEST_CVV=123
