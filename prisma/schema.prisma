generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(cuid())
  clerkId           String        @unique
  name              String?
  email             String        @unique
  image             String?
  preferredLanguage String        @default("english")
  defaultTone       String        @default("professional")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  autoSave          Boolean       @default(true)
  creativityLevel   Int?          @default(70)
  preferredModel    String?       @default("auto")
  preferredPlatform String?       @default("email")
  preferredStyle    String?       @default("standard")
  responseLength    String?       @default("medium")
  streamingEnabled  Boolean       @default(true)
  chats             Chat[]
  personas          Persona[]
  subscription      Subscription?
  usage             Usage?
  usageRecords      UsageRecord[]

  @@index([clerkId])
  @@index([email])
}

model Chat {
  id         String    @id @default(cuid())
  userId     String
  title      String    @default("New Chat")
  tone       String    @default("professional")
  model      String    @default("auto")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isArchived Boolean   @default(false)
  isFavorite Boolean   @default(false)
  isPinned   Boolean   @default(false)
  language   String?
  platform   String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId, updatedAt])
  @@index([userId, isPinned])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
}

model Message {
  id          String       @id @default(cuid())
  chatId      String
  role        String
  content     String
  tone        String?
  tokens      Int?
  latency     Int?
  model       String?
  platform    String?
  language    String?
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  feedback    String?
  isEdited    Boolean      @default(false)
  parentId    String?
  attachments Attachment[]
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  parent      Message?     @relation("MessageChain", fields: [parentId], references: [id])
  children    Message[]    @relation("MessageChain")

  @@index([chatId, createdAt])
  @@index([chatId, feedback])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  fileType   String
  fileSize   Int
  storageKey String
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Persona {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  systemPrompt String
  icon         String?
  color        String   @default("#6366F1")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Usage {
  id               String    @id @default(cuid())
  userId           String    @unique
  messagesSent     Int       @default(0)
  tokensUsed       Int       @default(0)
  filesUploaded    Int       @default(0)
  storageUsed      Int       @default(0)
  resetDate        DateTime  @default(now())
  creditsUsed      Int       @default(0)
  periodStart      DateTime  @default(now())
  periodEnd        DateTime?
  dailyMessages    Int       @default(0)
  dailyTokens      Int       @default(0)
  lastDailyReset   DateTime  @default(now())
  lastMonthlyReset DateTime  @default(now())
  monthlyMessages  Int       @default(0)
  monthlyTokens    Int       @default(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  model     String
  tokens    Int      @default(0)
  latency   Int      @default(0)
  success   Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, provider])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  status                 String
  plan                   String    @default("free")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  paymentProvider        String    @default("paddle")
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  providerPriceId        String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
