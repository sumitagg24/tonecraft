# ==========================================
# Application
# ==========================================
NEXT_PUBLIC_APP_URL=

# ==========================================
# Sentry (error monitoring & tracing)
# ==========================================
# Get these from Sentry: Project Settings -> Client Keys (DSN) and
# Settings -> Auth Tokens (for source map upload on build).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set SENTRY_DEBUG=true for verbose SDK logging (envelope send confirmation).
SENTRY_DEBUG=

# ==========================================
# Database (Neon PostgreSQL)
# ==========================================
# Pooled endpoint (PgBouncer transaction mode) — used by the app at runtime.
DATABASE_URL=
# Direct endpoint (no -pooler in host) — used by Prisma CLI (migrate, db pull, db push).
DIRECT_URL=

# ==========================================
# Background worker (scheduled automations)
# ==========================================
# Shared secret sent as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*.
# Vercel Cron sends this automatically when CRON_SECRET is set as a PROJECT env
# var on Vercel (Settings → Environment Variables). Use a long random URL-safe
# string — no spaces or special characters that could break an auth header.
CRON_SECRET=

# ==========================================
# Email (SMTP) — notification emails sent by the background queue worker
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ToneCraft <no-reply@tonecraft.app>

# ==========================================
# Web Push (VAPID) — browser push notifications
# ==========================================
# Generate a keypair with: node scripts/generate-vapid-keys.js
# VAPID_SUBJECT must be a mailto: or https: URL identifying the server.
# Without these, push notifications fail closed in production (logged, not dropped silently).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:feedback@tonecraft.app

# ==========================================
# Realtime (Socket.IO client)
# ==========================================
# Browser connects to the Socket.IO server here. Leave unset in dev (defaults
# to localhost:3000); set to your deployed socket URL in production.
NEXT_PUBLIC_SOCKET_URL=

# ==========================================
# Cloudflare R2 — file storage (chat attachments + knowledge originals)
# ==========================================
# Create an R2 bucket in Cloudflare, then an API token (R2 Read-Write) for its
# access key + secret. R2_PUBLIC_URL is optional: set it to the bucket's public
# custom domain (e.g. https://files.tonecraft.app) for direct-read links; when
# unset, downloads go through the signed-in /api/files route.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ==========================================
# Platform admin & user feedback
# ==========================================
# Comma-separated emails granted global admin (/admin/* platform surfaces).
# Leave empty to disable all global admin access (fail closed).
ADMIN_EMAILS=
# Where new feedback submissions are emailed (via the queue SMTP transport).
# Recommended: create a real inbox (e.g. feedback@tonecraft.app via Google
# Workspace, Zoho, or Cloudflare Email Routing forwarding to your personal
# inbox) and set it here. Leave empty to disable feedback email notifications.
FEEDBACK_NOTIFICATION_EMAIL=

# ==========================================
# Retention (daily cron) — bounded cleanup of high-growth tables
# ==========================================
# Windows in days for operational/trace tables (0 disables that table).
# Defaults: queue 30, audit 365, activity 180, notification 365,
# usage records 365, prompt history 365, document operations 180.
# Message / MemoryItem are user content and are DISABLED by default —
# only set RETENTION_DAYS_MESSAGE / RETENTION_DAYS_MEMORYITEM if you
# explicitly accept deleting user data.
RETENTION_DAYS_QUEUEITEM=30
RETENTION_DAYS_AUDITLOG=365
RETENTION_DAYS_ACTIVITY=180
RETENTION_DAYS_NOTIFICATION=365
RETENTION_DAYS_USAGERECORD=365
RETENTION_DAYS_PROMPTHISTORY=365
RETENTION_DAYS_DOCUMENTOPERATION=180
# Max rows deleted per daily run (prevents a single cron tick from
# holding the DB hostage).
RETENTION_MAX_ROWS_PER_RUN=100000




# ==========================================
# Clerk Authentication
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat
CLERK_WEBHOOK_SECRET=

# ==========================================
# AI Providers
# ==========================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
# Google model overrides (defaults: gemini-3.6-flash / gemini-3.1-pro-preview).
# gemini-2.5-* returns 404 for new API keys — set these to the model of your choice.
GOOGLE_AI_MODEL=
GOOGLE_AI_PRO_MODEL=
# Generic OpenAI-compatible provider slot — any OpenAI-compatible endpoint
# (GitHub Models, Cloudflare Workers AI, Cerebras, DeepInfra, Together, …).
# The provider only activates when all three are set; no code change needed.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
# Optional friendly label shown in logs/UI (defaults to "Custom model").
CUSTOM_AI_DISPLAY_NAME=
# CREDIT_OVERRIDE=true bypasses credit/usage limits (dev/staging only — never in prod).
CREDIT_OVERRIDE=

# ==========================================
# Embeddings (AI Memory — Phase 17)
# ==========================================
# Any OpenAI-compatible /embeddings endpoint (OpenAI, Together, Groq, …).
# Unset = deterministic hash-vector fallback (still works, lower fidelity).
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# ==========================================
# Voice & Multimodal (Phase 18 — uses OPENAI_API_KEY above)
# ==========================================
# Optional overrides for the OpenAI-compatible audio/vision models.
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
VISION_MODEL=gpt-4o-mini

# ==========================================

# ==========================================
# Upstash Redis (Rate Limiting & Caching)
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# E2E testing (CI only) — signed-in Playwright specs skip without these
# ==========================================
E2E_EMAIL=
E2E_PASSWORD=


# DODO PAYMENTS (Live)
DODO_PAYMENTS_API_KEY=your_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_secret_here
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_RETURN_URL=https://www.tonecraft.site/welcome
DODO_PRODUCT_BASIC=your_basic_product_id
DODO_PRODUCT_PRO=your_pro_product_id
DODO_PRODUCT_ADVANCED=your_advanced_product_id
# Annual variants (billed yearly, same plan grant) — required for the
# "Annual (20% off)" toggle to appear and for annual webhooks to sync.
DODO_PRODUCT_BASIC_ANNUAL=your_basic_annual_product_id
DODO_PRODUCT_PRO_ANNUAL=your_pro_annual_product_id
DODO_PRODUCT_ADVANCED_ANNUAL=your_advanced_annual_product_id
NEXT_PUBLIC_DODO_PRODUCT_BASIC=your_basic_product_id
NEXT_PUBLIC_DODO_PRODUCT_PRO=your_pro_product_id
NEXT_PUBLIC_DODO_PRODUCT_ADVANCED=your_advanced_product_id
NEXT_PUBLIC_DODO_PRODUCT_BASIC_ANNUAL=your_basic_annual_product_id
NEXT_PUBLIC_DODO_PRODUCT_PRO_ANNUAL=your_pro_annual_product_id
NEXT_PUBLIC_DODO_PRODUCT_ADVANCED_ANNUAL=your_advanced_annual_product_id
