# ==========================================
# Application
# ==========================================
NEXT_PUBLIC_APP_URL=

# ==========================================
# Database (Neon PostgreSQL)
# ==========================================
# Pooled endpoint (PgBouncer transaction mode) — used by the app at runtime.
DATABASE_URL=
# Direct endpoint (no -pooler in host) — used by Prisma CLI (migrate, db pull, db push).
DIRECT_URL=

# ==========================================
# Background worker (scheduled automations)
# ==========================================
# Shared secret that must be sent as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/automations. Vercel Cron sends this automatically.
CRON_SECRET=

# ==========================================
# Integrations (OAuth)
# ==========================================
# Slack (https://api.slack.com/apps → OAuth & Permissions, Bot Token scopes: chat:write, files:write)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# GitHub (https://github.com/settings/developers → OAuth Apps, scopes: repo, read:user)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# Clerk Authentication
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat
CLERK_WEBHOOK_SECRET=

# ==========================================
# AI Providers
# ==========================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# Paddle Billing
# ==========================================
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ENTERPRISE=

# ==========================================
# Upstash Redis (Rate Limiting & Caching)
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# Cloudflare R2 (File Storage)
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
