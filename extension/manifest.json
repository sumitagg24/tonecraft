{
  "manifest_version": 3,
  "name": "ToneCraft — Rewrite Anywhere",
  "version": "1.0.0",
  "description": "Select text on any page and rewrite it with ToneCraft's tone engine, or open a tool from the popup. Free plan: 5 AI generations per day.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ToneCraft — Rewrite Anywhere",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
