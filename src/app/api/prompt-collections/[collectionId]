  return;
}

export async function POST(ctx, body) {
  const data = await body as { name: string; description?: string; isPublic?: boolean };
  const collection = await PromptService.createCollection(ctx.user.id, data);
  return;
}

export async function PATCH(ctx, body) {
  const data = await body as { name?: string; description?: string; isPublic?: boolean };
  const result = await PromptService.updateCollection(ctx.param.id, ctx.user.id, data);
